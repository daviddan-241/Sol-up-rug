# Copy to .env for local testing (not used on Render automatically)
# Operator takes a fee per action
OPERATOR_PUBKEY=YourOperatorPubkeyHere
# Charge a USD-denominated fee per action (converted to SOL at runtime)
FEE_USD=3
# Alternatively, force a fixed SOL fee and leave FEE_USD unset
# FEE_SOL_OVERRIDE=0.025
# Select network: devnet | mainnet-beta | testnet
NETWORK=devnet
# Optional custom RPC URL (strongly recommended for mainnet)
# RPC_URL=https://your-provider.example.com
# Disable devnet airdrop helper (always true on non-devnet)
DISABLE_AIRDROP=false
